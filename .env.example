# Public base URL of momong-api (Fly). Public value, not a secret. Leave empty to run fully local (no sync).
VITE_API_URL=

# Phase 1 is Free-only. Enable only for the verified Phase 2 release.
VITE_PLUS_ENABLED=false

# PostHog public project token only. Off until project setup is complete.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
