{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sync",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/me",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/household/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/wishlist/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/billing/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://momong-api.evanyudis.my.id/api/:path*",
      "respectOriginCacheControl": false
    },
    {
      "source": "/sync",
      "destination": "https://momong-api.evanyudis.my.id/sync",
      "respectOriginCacheControl": false
    },
    {
      "source": "/me",
      "destination": "https://momong-api.evanyudis.my.id/me",
      "respectOriginCacheControl": false
    },
    {
      "source": "/household/:path*",
      "destination": "https://momong-api.evanyudis.my.id/household/:path*",
      "respectOriginCacheControl": false
    },
    {
      "source": "/wishlist/:path*",
      "destination": "https://momong-api.evanyudis.my.id/wishlist/:path*",
      "respectOriginCacheControl": false
    },
    {
      "source": "/billing/:path*",
      "destination": "https://momong-api.evanyudis.my.id/billing/:path*",
      "respectOriginCacheControl": false
    }
  ],
  "buildCommand": "VITE_PLUS_ENABLED=false npm run build"
}
